# Force LF for shell scripts and POSIX-style files (bash/Linux/Pi safety).
# Without this, Git on Windows может конвертировать в CRLF и сломать shebang/heredoc.
*.sh             text eol=lf
*.bash           text eol=lf
samurai          text eol=lf
scripts/cmds/*   text eol=lf

# Python — единый стиль на всех платформах
*.py             text eol=lf

# YAML / JSON / Markdown — текст с автодетектом, но stable
*.yaml           text
*.yml            text
*.json           text
*.md             text

# Docker / config
Dockerfile*      text eol=lf
*.service        text eol=lf
*.conf           text eol=lf

# Web frontend
*.ts             text eol=lf
*.tsx            text eol=lf
*.js             text eol=lf
*.jsx            text eol=lf
*.css            text eol=lf
*.html           text eol=lf

# Бинарники — никаких преобразований
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.pdf            binary
*.pptx           binary
*.pt             binary
*.onnx           binary
*.zip            binary
*.tar            binary
*.gz             binary
